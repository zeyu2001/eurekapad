{
  "name": "@eurekapad/tiptap-extensions",
  "version": "0.0.0",
  "type": "module",
  "description": "TipTap extensions for EurekaPad",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && rollup -c",
    "dev": "pnpm run clean && rollup -c -w",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eurekapad/eslint-config": "workspace:*",
    "@eurekapad/prettier-config": "workspace:*",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@tiptap/core": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.29.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-sourcemaps2": "^0.4.3",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "prettier": "@eurekapad/prettier-config",
  "dependencies": {
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "1.38.0"
  }
}
