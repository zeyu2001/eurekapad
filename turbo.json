{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "CLERK_SECRET_KEY",
        "CONVEX_DEPLOYMENT",
        "CLERK_WEBHOOK_SECRET",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID",
        "SENTRY_AUTH_TOKEN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build:preview": {
      "dependsOn": ["^build"]
    },
    "build:deploy": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "CLERK_SECRET_KEY",
        "CONVEX_DEPLOYMENT",
        "CONVEX_DEPLOY_KEY",
        "CLERK_WEBHOOK_SECRET",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID",
        "SENTRY_AUTH_TOKEN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "env": ["NEXT_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^build", "^lint:fix"]
    },
    "format": {
      "dependsOn": ["lint:fix"]
    },
    "format:check": {
      "dependsOn": ["lint"]
    }
  }
}
